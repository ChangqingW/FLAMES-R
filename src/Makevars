# Define C++ standard
CXX_STD = CXX17

# Define source files excluding submodule
CFILES = $(filter-out submodule/%, $(wildcard \
	*.c \
	**/*.c \
	**/*/*.c \
))
CPPFILES = $(filter-out submodule/%, $(wildcard \
	*.cpp \
	**/*.cpp \
	**/*/*.cpp \
))

# Combine C and C++ files
FILES = $(CFILES) $(CPPFILES)
SOURCES = $(FILES)
OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

# Define Rhtslib flags
RHTSLIB_LIBS=$(shell "${R_HOME}/bin${R_ARCH_BIN}/Rscript" -e \
	'Rhtslib::pkgconfig("PKG_LIBS")')
RHTSLIB_CPPFLAGS=$(shell "${R_HOME}/bin${R_ARCH_BIN}/Rscript" -e \
	'Rhtslib::pkgconfig("PKG_CPPFLAGS")')

PKG_CPPFLAGS = -pthread $(RHTSLIB_CPPFLAGS)
PKG_LIBS = -pthread -lz $(RHTSLIB_LIBS)

# Define CFLAGS for minimap2
# omit unused-result for suppressing R CMD check warnings
MINIMAP2_CFLAGS = $(CFLAGS) -Wno-unused-result

# Define architecture
UNAME_M := $(shell uname -m)

# Define Rust build variables
RUSTC := $(shell command -v rustc 2>/dev/null)
CARGO := $(shell command -v cargo 2>/dev/null)
RUST_VERSION := $(shell rustc --version | sed -E 's/rustc ([0-9]+\.[0-9]+\.[0-9]+).*/\1/' 2>/dev/null)
RUST_OK := $(shell [ "$(RUST_VERSION)" != "" ] && \
                   [ "$$(printf '%s\n' 1.85.0 $(RUST_VERSION) | sort -V | head -n1)" = "1.85.0" ] && echo "yes" || echo "no")

# Which bundled command-line tools to build at install time (env-controlled):
#   all      build both minimap2 and oarfish (DEFAULT; required so FLAMES's
#            runnable man-page examples work on the Bioconductor build machines)
#   none     build neither  -- rely entirely on system-provided tools
#   missing  build only the tools NOT already found on PATH
# Distributions that ship minimap2/oarfish separately (e.g. conda/bioconda) can
# set this to `none` or `missing`; FLAMES resolves system tools from PATH at
# runtime via find_bin() (R/binaries.R). Unset behaves as `all`.
FLAMES_BUILD_TOOLS ?= all

# Per-tool PATH probes (empty string when the tool is absent)
MINIMAP2_ON_PATH := $(shell command -v minimap2 2>/dev/null)
OARFISH_ON_PATH  := $(shell command -v oarfish 2>/dev/null)

BUNDLED_BINS =
ifeq ($(FLAMES_BUILD_TOOLS),all)
  BUNDLED_BINS = ../inst/bin/minimap2 ../inst/bin/oarfish
else ifeq ($(FLAMES_BUILD_TOOLS),none)
  # build neither
else ifeq ($(FLAMES_BUILD_TOOLS),missing)
  ifeq ($(MINIMAP2_ON_PATH),)
    BUNDLED_BINS += ../inst/bin/minimap2
  endif
  ifeq ($(OARFISH_ON_PATH),)
    BUNDLED_BINS += ../inst/bin/oarfish
  endif
else
  $(warning FLAMES_BUILD_TOOLS='$(FLAMES_BUILD_TOOLS)' unrecognised; expected all|none|missing. Defaulting to 'all'.)
  BUNDLED_BINS = ../inst/bin/minimap2 ../inst/bin/oarfish
endif

# Targets
all: strippedLib $(BUNDLED_BINS)

strippedLib: $(SHLIB)
	if test -e "/usr/bin/strip" & test -e "/bin/uname" & [[ `uname` == "Linux" ]] ; then /usr/bin/strip --strip-debug $(SHLIB); fi

../inst/bin/minimap2:
ifeq ($(UNAME_M),arm64)
	@echo "Building for ARM64"
	(cd submodule/minimap2 && $(MAKE) -f Makefile CFLAGS="$(MINIMAP2_CFLAGS)" arm_neon=1 aarch64=1 minimap2)
else ifeq ($(UNAME_M),aarch64)
	@echo "Building for ARM64"
	(cd submodule/minimap2 && $(MAKE) -f Makefile CFLAGS="$(MINIMAP2_CFLAGS)" arm_neon=1 aarch64=1 minimap2)
else
	@echo "Building for x86_64"
	(cd submodule/minimap2 && $(MAKE) -f Makefile CFLAGS="$(MINIMAP2_CFLAGS)" minimap2)
endif
	echo "Installing binary to $(PWD)/../inst/bin"
	mkdir -p ../inst/bin
	cp submodule/minimap2/minimap2 ../inst/bin/

# smuggle oarfish if cargo is available
../inst/bin/oarfish:
ifeq ($(CARGO),)
	@echo "Cargo not found, skipping oarfish installation."
else ifeq ($(RUST_OK),no)
	@echo "Rust version too old for edition 2024, skipping oarfish installation."
else
	@echo "Building oarfish with cargo"
	mkdir -p ../inst/bin
	mkdir cargo_temp
	# crates.io has no 0.8.1 (it skips from 0.8.0 to 0.9.0). The v0.8.1 that
	# download_oarfish() in R/binaries.R fetches is a GitHub *release binary*, not a
	# published crate, so this cargo build must stay on a crates.io version (0.8.0).
	(cargo install oarfish --root cargo_temp --bin oarfish --vers 0.8.0)
	cp cargo_temp/bin/oarfish ../inst/bin/
	cargo uninstall oarfish --root cargo_temp
	rm -rf cargo_temp
endif

clean:
	rm $(OBJECTS)
	cd submodule/minimap2 2>/dev/null && $(MAKE) clean || true

.PHONY: strippedLib clean
